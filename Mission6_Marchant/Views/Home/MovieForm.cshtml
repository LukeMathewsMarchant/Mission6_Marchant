@model Movie
@{
    ViewData["Title"] = "Add Movie";
}

<div class="container mt-4">
    <h1>Add a Movie to the Collection</h1>

    <form method="post">
        @* Validation Summary for errors *@
        <input type="hidden" asp-for="MovieId" />
        <div asp-validation-summary="All" class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="CategoryId" class="form-label">Category</label>
            <select asp-for="CategoryId" class="form-select" required>
                <option value="">Select a Category</option>
                @foreach (var c in ViewBag.Categories)
                {
                    <option value="@c.CategoryId">@c.CategoryName</option>
                }
            </select>
        </div>

        <div class="mb-3">
            <label asp-for="Title" class="form-label">Title</label>
            <input asp-for="Title" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="Year" class="form-label">Year</label>
            <input asp-for="Year" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="Director" class="form-label">Director</label>
            <input asp-for="Director" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="Rating" class="form-label">Rating</label>
            <select asp-for="Rating" class="form-select">
                <option value="G">G</option>
                <option value="PG">PG</option>
                <option value="PG-13">PG-13</option>
                <option value="R">R</option>
            </select>
        </div>

        <div class="mb-3">
            <label asp-for="LentTo" class="form-label">Lent To</label>
            <input asp-for="LentTo" class="form-control" />
        </div>

        <div class="mb-3 form-check">
            <input asp-for="Edited" class="form-check-input" type="checkbox" value="true" />
            <label asp-for="Edited" class="form-check-label">Edited</label>
        </div>

        <div class="mb-3 form-check">
            <input asp-for="CopiedToPlex" class="form-check-input" type="checkbox" value="true" />
            <label asp-for="CopiedToPlex" class="form-check-label">Copied to Plex</label>
        </div>

        <div class="mb-3">
            <label asp-for="Notes" class="form-label">Notes (Max 25 chars)</label>
            <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
        </div>

        <button type="submit" class="btn btn-primary">Submit Movie</button>
    </form>
</div>